/// Daily ticket counter per store, so tickets read #1, #2, #3 each service day
/// instead of restarting at 1 for every order. One row per store per day; bumped
/// with an atomic upsert so two waiters sending at once never share a number.
model KotCounter {
  storeId String
  day     String
  last    Int    @default(0)

  @@id([storeId, day])
}

