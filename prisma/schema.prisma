  litresDispensed Float
  pricePerLitreCents Int
  totalCents      Int
  paymentMethod   String    @default("CASH")
  paymentRef      String?
  saleId          String?   @unique
  /// The tank the litres came from, so a void puts them back where they were drawn (null for a sale from before this was kept).
  tankId          String?
  voidedAt        DateTime?
  voidedBy        String?
  voidReason      String?
  status          String    @default("COMPLETED")  // AUTHORIZED | COMPLETED | VOIDED
  authorizedAt    DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  pump            FuelPump  @relation(fields: [pumpId], references: [id])
  grade           FuelGrade @relation(fields: [gradeId], references: [id])

  @@index([businessId, storeId, createdAt])
  @@index([pumpId])
  @@index([status])
}

// ─── Fuel Pump Enterprise Extensions ─────────────────────────────────────────

model FuelTank {
  id             String   @id @default(uuid())
  businessId     String
  storeId        String
  tankNumber     Int
  label          String?
  gradeId        String
  capacityLitres Float
  currentLitres  Float    @default(0)
  minLevelLitres Float    @default(500)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  grade          FuelGrade @relation(fields: [gradeId], references: [id])
  dippings       FuelTankDipping[]
  deliveries     FuelDelivery[]

  @@unique([businessId, storeId, tankNumber])
  @@index([businessId, storeId])
}

model FuelTankDipping {
  id          String   @id @default(uuid())
  businessId  String
  tankId      String
  litres      Float
  recordedBy  String
  notes       String?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  tank        FuelTank @relation(fields: [tankId], references: [id])

  @@index([tankId, recordedAt])
}

model FuelDelivery {
  id             String   @id @default(uuid())
  businessId     String
  tankId         String
  litresDelivered Float
  supplierName   String?
  docketNumber   String?
  deliveredBy    String?
  notes          String?
  deliveredAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  tank           FuelTank @relation(fields: [tankId], references: [id])

  @@index([businessId, deliveredAt])
}

model FuelShift {
  id          String    @id @default(uuid())
  businessId  String
  storeId     String
  cashierId   String?
  cashierName String
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  status      String    @default("OPEN")
  notes       String?
  readings    FuelShiftReading[]

  @@index([businessId, storeId, status])
}

model FuelShiftReading {
  id            String    @id @default(uuid())
  shiftId       String
  pumpId        String
  openingLitres Float
  closingLitres Float?
  createdAt     DateTime  @default(now())
  shift         FuelShift @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
}

model FleetAccount {
  id               String   @id @default(uuid())
  businessId       String
  companyName      String
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  kraPin           String?
  creditLimitCents Int      @default(0)
  balanceCents     Int      @default(0)
  /// What the books believe this account owes (kept in step while the sales pipeline is on, topped up when it is switched back on).
  ledgerOwedCents  Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  transactions     FleetTransaction[]

  @@index([businessId])
}

model FleetTransaction {
  id             String       @id @default(uuid())
  businessId     String
  fleetAccountId String
  fuelSaleId     String?
  type           String
  amountCents    Int
  description    String?
  reference      String?
  createdAt      DateTime     @default(now())
  account        FleetAccount @relation(fields: [fleetAccountId], references: [id])

  @@index([fleetAccountId, createdAt])
}

model FuelPumpMaintenance {
  id             String    @id @default(uuid())
  businessId     String
  pumpId         String
  type           String    // REPAIR | SERVICE | CALIBRATION | INSPECTION | EMERGENCY
  description    String
  technicianName String?
  costCents      Int       @default(0)
  status         String    @default("COMPLETED")  // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  pump           FuelPump  @relation(fields: [pumpId], references: [id])

  @@index([businessId, pumpId])
  @@index([pumpId, startedAt])
}

// ─── Pharmacy Enterprise Extensions ──────────────────────────────────────────

model DrugCatalogue {
  id           String   @id @default(uuid())
  businessId   String
  genericName  String
  brandName    String?
  strength     String?
  dosageForm   String?
  category     String?
  scheduleClass String?
  defaultInstructions String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([businessId])
  @@index([genericName])
}

// ─── Cybercafe Enterprise Extensions ─────────────────────────────────────────

model CyberStation {
  id               String   @id @default(uuid())
  businessId       String
  storeId          String
  number           Int
  label            String?  // e.g. "PC 1", "Gaming Rig A"
  specs            String?  // e.g. "Intel i5, 16GB RAM, GTX 1650"
  ratePerHourCents Int      @default(0)
  stationType      String   @default("BROWSING")  // BROWSING | GAMING | WORKSTATION | PRINTING
  status           String   @default("AVAILABLE")  // AVAILABLE | IN_USE | PAUSED | OFFLINE
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sessions         CyberSession[]

  @@unique([businessId, storeId, number])
  @@index([businessId, storeId, status])
}

model CyberSession {
  id               String    @id @default(uuid())
  businessId       String
  storeId          String
  stationId        String
  customerId       String?
  customerName     String?
  customerPhone    String?
  packageId        String?
  timeLimitMinutes Int?
  startedAt        DateTime  @default(now())
  pausedAt         DateTime?
  pausedMinutes    Float     @default(0)
  extendedMinutes  Float     @default(0)
  endedAt          DateTime?
  durationMinutes  Float?
  ratePerHourCents Int
  printPagesCents  Int       @default(0)
  extrasCents      Int       @default(0)
  totalCents       Int       @default(0)
  status           String    @default("ACTIVE")  // ACTIVE | PAUSED | COMPLETED | VOIDED
  paymentMethod    String?
  paymentRef       String?
  saleId           String?
  notes            String?
  createdAt        DateTime  @default(now())
  station          CyberStation  @relation(fields: [stationId], references: [id])
  package          CyberPackage? @relation(fields: [packageId], references: [id])

  @@index([businessId, storeId, status])
  @@index([stationId, status])
  @@index([businessId, createdAt])
}

model CyberPackage {
  id              String   @id @default(uuid())
  businessId      String
  name            String
  durationMinutes Int
  priceCents      Int
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  sessions        CyberSession[]

  @@index([businessId])
}

model CyberRate {
  id          String   @id @default(uuid())
  businessId  String
  storeId     String
  service     String
  unit        String   @default("per page") // per page, per hour, per item, flat
  rateCents   Int      @default(0)
  category    String   @default("PRINT") // PRINT | SCAN | BROWSE | GAME | OTHER
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, storeId])
}

model Category {
  id         String   @id @default(uuid())
  businessId String
  name       String
  color      String   @default("#6B7280")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
  items      Item[]   @relation("CategoryItems")

  @@unique([businessId, name])
  @@index([businessId])
}

model ItemUOM {
  id               String   @id @default(uuid())
  itemId           String
  unitName         String
  unitAbbrev       String
  conversionFactor Float    @default(1)
  isBaseUnit       Boolean  @default(false)
  priceCents       Int?
  barcode          String?
  createdAt        DateTime @default(now())
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, unitName])
  @@index([itemId])
  @@index([barcode])
}

// ─── Field Sales / Route-to-Market ──────────────────────────────────────────

model SalesRoute {
  id           String        @id @default(uuid())
  businessId   String
  branchId     String?       // Store id
  name         String
  deliveryDays String        @default("[]") // JSON array: ["MON","WED","FRI"]
  driverUserId String?
  color        String        @default("#6366F1")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  customers    Customer[]
  deliveryRuns DeliveryRun[]
  fieldOrders  FieldOrder[]

  @@index([businessId])
  @@index([isActive])
}

model DeliveryRun {
  id           String            @id @default(uuid())
  businessId   String
  routeId      String
  date         DateTime          @db.Date
  driverUserId String?
  status       String            @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  notes        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  route        SalesRoute        @relation(fields: [routeId], references: [id])
  driver       User?             @relation("DriverRuns", fields: [driverUserId], references: [id])
  orders       DeliveryRunOrder[]
  expenses     RouteExpense[]

  @@index([businessId, date])
  @@index([routeId])
  @@index([status])
}

model DeliveryRunOrder {
  id            String        @id @default(uuid())
  deliveryRunId String
  fieldOrderId  String
  sortOrder     Int           @default(0)
  status        String        @default("PENDING") // PENDING | DELIVERED | PARTIAL | FAILED
  deliveredAt   DateTime?
  failureReason String?
  createdAt     DateTime      @default(now())
  deliveryRun   DeliveryRun   @relation(fields: [deliveryRunId], references: [id], onDelete: Cascade)
  fieldOrder    FieldOrder    @relation(fields: [fieldOrderId], references: [id])
  proof         DeliveryProof?

  @@unique([deliveryRunId, fieldOrderId])
  @@index([deliveryRunId])
  @@index([fieldOrderId])
}

model DeliveryProof {
  id                 String           @id @default(uuid())
  fieldOrderId       String
  deliveryRunOrderId String           @unique
  signatureBase64    String?          // base64 canvas signature
  receivedByName     String
  latitude           Float?
  longitude          Float?
  photoUrl           String?
  notes              String?
  capturedAt         DateTime         @default(now())
  fieldOrder         FieldOrder       @relation(fields: [fieldOrderId], references: [id])
  deliveryRunOrder   DeliveryRunOrder @relation(fields: [deliveryRunOrderId], references: [id])

  @@index([fieldOrderId])
}

model RouteExpense {
  id            String      @id @default(uuid())
  businessId    String
  deliveryRunId String
  category      String      // FUEL | DRIVER_ALLOWANCE | FOOD | OTHER
  amountCents   Int
  description   String?
  receiptUrl    String?
  recordedBy    String      // User.id
  createdAt     DateTime    @default(now())
  deliveryRun   DeliveryRun @relation(fields: [deliveryRunId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([deliveryRunId])
}

model FieldOrder {
  id                   String             @id @default(uuid())
  offlineId            String             @unique
  businessId           String
  storeId              String?
  orderNumber          String?            @unique
  agentId              String             // User.id (SALES_AGENT)
  customerId           String
  routeId              String?
  status               String             @default("DRAFT")
  // DRAFT | SUBMITTED | CONFIRMED | PACKED | DISPATCHED | DELIVERED | INVOICED | CANCELLED
  subtotalCents        Int                @default(0)
  vatCents             Int                @default(0)
  totalCents           Int                @default(0)
  isSampleOrder        Boolean            @default(false)
  notes                String?
  rejectionReason      String?
  expectedDeliveryDate DateTime?
  paymentStatus        String             @default("UNPAID") // UNPAID | PARTIAL | PAID
  paymentMethod        String?            // MPESA_STK | MPESA_PAYBILL
  mpesaReference       String?
  paidAmountCents      Int                @default(0)
  confirmedAt          DateTime?
  packedAt             DateTime?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  invoiceNumber        String?            // proforma receiptNumber after Generate Invoice
  invoicedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  agent                User               @relation("AgentOrders", fields: [agentId], references: [id])
  customer             Customer           @relation(fields: [customerId], references: [id])
  route                SalesRoute?        @relation(fields: [routeId], references: [id])
  items                FieldOrderItem[]
  deliveryRunOrders    DeliveryRunOrder[]
  proof                DeliveryProof[]
  creditRequests       CreditApprovalRequest[]
  payments             FieldOrderPayment[]

  @@index([businessId, status])
  @@index([agentId])
  @@index([customerId])
  @@index([routeId])
  @@index([orderNumber])
  @@index([paymentStatus])
}

// Individual payment collected against a field order — gives an audit trail and
// idempotency for offline payment replay (offlineId is the client's dedup key).
model FieldOrderPayment {
  id           String     @id @default(uuid())
  offlineId    String?    @unique
  fieldOrderId String
  businessId   String
  amountCents  Int
  method       String     // CASH | MPESA | BANK | CHEQUE
  reference    String?
  collectedBy  String     // User.id (SALES_AGENT)
  createdAt    DateTime   @default(now())
  fieldOrder   FieldOrder @relation(fields: [fieldOrderId], references: [id], onDelete: Cascade)

  @@index([fieldOrderId])
  @@index([businessId])
}

model FieldOrderItem {
  id                  String     @id @default(uuid())
  fieldOrderId        String
  itemId              String?
  itemName            String     // snapshot at time of order
  itemSku             String?
  quantity            Int
  unitPriceCents      Int
  totalCents          Int
  isSample            Boolean    @default(false)
  deliveredQuantity   Int        @default(0)
  backOrderQuantity   Int        @default(0)
  createdAt           DateTime   @default(now())
  fieldOrder          FieldOrder @relation(fields: [fieldOrderId], references: [id], onDelete: Cascade)

  @@index([fieldOrderId])
  @@index([itemId])
}

model CreditApprovalRequest {
  id                  String     @id @default(uuid())
  businessId          String
  customerId          String
  fieldOrderId        String?
  requestedBy         String     // User.id (agent)
  currentLimitCents   Int
  requestedLimitCents Int
  orderTotalCents     Int        @default(0)
  reason              String?
  status              String     @default("PENDING") // PENDING | APPROVED | DECLINED
  reviewedBy          String?    // User.id (manager/owner)
  reviewedAt          DateTime?
  reviewNote          String?
  createdAt           DateTime   @default(now())
  customer            Customer   @relation(fields: [customerId], references: [id])
  fieldOrder          FieldOrder? @relation(fields: [fieldOrderId], references: [id])
  requestedByUser     User       @relation("CreditRequestedBy", fields: [requestedBy], references: [id])
  reviewedByUser      User?      @relation("CreditReviewedBy", fields: [reviewedBy], references: [id])

  @@index([businessId, status])
  @@index([customerId])
  @@index([requestedBy])
}

model CustomerPortalSession {
  id           String   @id @default(uuid())
  customerId   String
  phone        String
  sessionToken String   @unique // hashed SHA-256
  otpHash      String?  // hashed OTP for verification
  otpExpiresAt DateTime?
  otpAttempts  Int      @default(0) // failed verifies against the current OTP
  otpSentAt    DateTime? // last time a code went out — enforces the resend cooldown
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([phone])
}

model AgentVisit {
  id           String     @id @default(uuid())
  agentId      String     // User.id
  customerId   String
  businessId   String
  fieldOrderId String?
  outcome      String     @default("VISITED") // VISITED | ORDERED | NO_ANSWER | DECLINED | FOLLOW_UP
  notes        String?
  gpsLat       Float?
  gpsLng       Float?
  visitedAt    DateTime   @default(now())
  agent        User       @relation(fields: [agentId], references: [id])
  customer     Customer   @relation(fields: [customerId], references: [id])

  @@index([agentId])
  @@index([customerId])
  @@index([visitedAt])
}

/// One thing sent (or logged as sent) to a printer: the audit trail and the delivery queue.
/// Receipts, kitchen tickets, bills, cash drawer pulses and test prints all land here.
/// `payload` holds the ESC/POS bytes (base64) while a job waits for a print bridge; client-side
/// prints (browser dialog, USB, Bluetooth) are logged without bytes.
/// Deliberately has no foreign keys: the history must survive a printer or sale being deleted.
model PrintJob {
  id            String    @id @default(uuid())
  businessId    String
  storeId       String
  printerId     String?
  kind          String
  status        String    @default("QUEUED")
  method        String    @default("BRIDGE")
  payload       String?
  payloadBytes  Int       @default(0)
  saleId        String?
  refNumber     String?
  copyNumber    Int       @default(0)
  reason        String?
  attempts      Int       @default(0)
  lastError     String?
  createdById   String?
  claimedBy     String?
  claimedAt     DateTime?
  nextAttemptAt DateTime  @default(now())
  sentAt        DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([businessId, storeId, status])
  @@index([saleId, kind])
  @@index([printerId])
}

/// A till (or small computer) on the shop network that delivers queued print jobs to LAN printers.
/// It signs in with a long-lived token instead of a person's login, which expires. Only the SHA-256 of
/// the token is stored; the token itself is shown once when the station is created.
model PrintStation {
  id          String    @id @default(uuid())
  businessId  String
  storeId     String
  name        String
  tokenHash   String    @unique
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([businessId, storeId])
}

/// Money that moved through a till or drawer outside a sale: a hotel deposit taken at booking, a deposit refunded.
/// The cash drawer reads these, so expected cash is right when a deposit is taken or handed back.
model CashMovement {
  id          String   @id @default(uuid())
  businessId  String
  storeId     String
  cashierId   String?
  /// PAY_IN or PAY_OUT.
  kind        String
  /// CASH, MPESA, CARD or BANK. Only CASH touches the drawer.
  method      String
  amountCents Int
  /// HOTEL_DEPOSIT, HOTEL_DEPOSIT_REFUND, HOTEL_DEPOSIT_FORFEIT, HOTEL_ROOM_CHARGE_PAID, APPOINTMENT_DEPOSIT, APPOINTMENT_DEPOSIT_REFUND, APPOINTMENT_DEPOSIT_FORFEIT.
  reason      String
  reference   String?
  /// The room booking, or the appointment, a deposit belongs to.
  bookingId   String?
  createdAt   DateTime @default(now())

  @@index([businessId, storeId, createdAt])
  @@index([bookingId])
}
