  nozzleCount Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  grade       FuelGrade  @relation(fields: [gradeId], references: [id])
  fuelSales   FuelSale[]
  maintenance FuelPumpMaintenance[]

  @@unique([businessId, storeId, pumpNumber])
  @@index([businessId, storeId, status])
}

model FuelSale {
  id              String    @id @default(uuid())
  businessId      String
  storeId         String
  pumpId          String
