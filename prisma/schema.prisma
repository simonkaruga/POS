  businessId String
  phone      String
  /// OTP (customer login code) or GENERAL (receipts, delivery updates, everything else)
  purpose    String
  /// PLATFORM = the shared Faida account (costs us), BUSINESS = the business's own account
  channel    String
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([businessId, channel, createdAt])
  @@index([phone, purpose, createdAt])
}

