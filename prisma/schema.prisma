  @@index([scheduledAt])
}

model DeliveryOrder {
  id                  String    @id @default(uuid())
  businessId          String
  storeId             String
  orderNumber         String    @unique
  saleId              String?
  // Set when this delivery was generated from a field/agent order dispatched onto a
  // delivery run, so the driver app and the field-sales board stay in sync.
  fieldOrderId        String?
  customerId          String?
  customerName        String
  customerPhone       String?
  deliveryAddress     String
  zoneId              String?
  courierProvider     String?
  courierOrderId      String?
  trackingUrl         String?
  estimatedDeliveryAt DateTime?
  failedAttempts      Int       @default(0)
  rescheduleReason    String?
  rescheduledAt       DateTime?
  driverId            String?
  scheduledAt         DateTime?
  pickedUpAt          DateTime?
  deliveredAt         DateTime?
  status              String    @default("PENDING")
  deliveryFeeCents    Int       @default(0)
  // Online/portal order extensions (structured items + payment + acceptance)
  channel             String    @default("POS")     // POS | PORTAL (customer self-service)
  fulfillmentType     String    @default("DELIVERY") // DELIVERY | PICKUP
  subtotalCents       Int       @default(0)
  taxCents            Int       @default(0)
  totalCents          Int       @default(0)
  paymentStatus       String    @default("UNPAID")  // UNPAID | PAID
  paymentRef          String?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  etaMinutes          Int?
  lat                 Float?
  lng                 Float?
  proofPhotoUrl       String?
  receivedBy          String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  business            Business  @relation(fields: [businessId], references: [id])
  customer            Customer? @relation(fields: [customerId], references: [id])
