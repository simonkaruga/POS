  businessId              String
  name                    String
  phone                   String?
  email                   String?
  phoneVerifiedAt         DateTime?               // set on first successful portal OTP verify (self-service customer app)
  deviceToken             String?                 // Expo push token (self-service customer app)
  creditLimitCents        Int                     @default(0)
  creditLimitPendingCents Int                     @default(0)
  creditApprovalStatus    String                  @default("NONE")
  balanceCents            Int                     @default(0)
  loyaltyPoints           Int                     @default(0)
  kraPin                  String?                 // KRA PIN for B2B tax invoice (e.g. A012345678Z)
  // Field sales extensions
  shopCode                String?                 @unique
  shopType                String?                 // RETAIL | WHOLESALE | KIOSK | SUPERMARKET
  salesAgentId            String?                 // owning User (SALES_AGENT role)
  routeId                 String?                 // assigned delivery route
  paymentTermsDays        Int                     @default(7)
  creditApproved          Boolean                 @default(false)
  creditApprovedBy        String?
  creditApprovedAt        DateTime?
  gpsLat                  Float?
  gpsLng                  Float?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  appointments            Appointment[]
  deliveries              DeliveryOrder[]
  fieldOrders             FieldOrder[]
  layaways                Layaway[]
  portalSessions          CustomerPortalSession[]
  agentVisits             AgentVisit[]
  creditRequests          CreditApprovalRequest[]
  addresses               CustomerAddress[]
  sales                   Sale[]
  salesAgent              User?                   @relation("AgentCustomers", fields: [salesAgentId], references: [id])
  route                   SalesRoute?             @relation(fields: [routeId], references: [id])

