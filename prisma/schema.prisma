model FuelGrade {
  id           String     @id @default(uuid())
  businessId   String
  storeId      String
  name         String     // e.g. "Petrol 91", "Diesel", "Premium 95"
  code         String     // short code e.g. "P91"
  pricePerLitreCents Int
  /// The catalogue item this grade is sold as on the invoice (made on the first sale after cutover).
  itemId             String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  pumps        FuelPump[]
  fuelSales    FuelSale[]
