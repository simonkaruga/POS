generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Direct (non-pooled) connection — required by `prisma migrate` when
  // DATABASE_URL goes through a transaction-mode pooler (e.g. Supabase :6543).
  // Locally, set DIRECT_URL to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model Business {
  id                            String                @id @default(uuid())
  name                          String
  taxType                       String                @default("VAT")
  serviceChargeRate             Float                 @default(10)
  negativePolicyDefault         String                @default("WARN")
  posMode                       String                @default("RETAIL")
  enabledModules                String                @default("[]")
  /// The moment fuel, hotel, pharmacy, cyber and appointment takings started becoming real Sales (receipt, eTIMS, Z-report,
  /// drawer, ledger). Null = still off, so a shop that rings those takings through the till is not counted twice.
  verticalSalesFrom   DateTime?
  /// Optional levies a hotel adds to a stay (tourism, catering): JSON [{ name, ratePct, base: "ROOM" | "ALL" }]. Empty = none.
  hotelLevies         String              @default("[]")
  expiredItemPolicy             String                @default("BLOCK")
  expenseApprovalThresholdCents Int?                  @default(500000)
  expiryAlertDays               Int                   @default(30)
  etimsCredentialsEncrypted     String?
  mpesaCredentialsEncrypted     String?
  atCredentialsEncrypted        String?
  etimsMode                     String                @default("SANDBOX")
  etimsProductionOnboarded      Boolean               @default(false)
  kraItaxIntegrationEnabled     Boolean               @default(false)
  kraItaxCredentials            String?
  // A gifted or internal account: full access, but nobody paid. Excluded from MRR
  // and ARR, which otherwise count every ACTIVE business at its list price and
  // report revenue that does not exist.
  isComped                      Boolean               @default(false)
  compedReason                  String?
  // "TRIAL" is a STATUS, not a tier — it was the default here and resolved to
  // FREE everywhere, so every new signup was silently treated as free. Access
  // during a trial comes from subscriptionStatus + trialEndsAt via
  // effectiveTier(), so the tier can default to what they have actually paid for.
  subscriptionTier              String                @default("FREE")
  subscriptionStatus            String                @default("TRIAL")
  trialEndsAt                   DateTime?
  // Display label only. Derived from subscriptionTier on write — never gate on it.
  planName                      String                @default("Free")
  paystackCustomerId            String?
  paystackSubscriptionId        String?
  paystackPublicKey             String?
  referralCode                  String?               @unique
  affiliateCode                 String?               // affiliate code this business signed up under (external partner program)
  shortCode                     String?               @unique
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  exchangeRates                 String?
  displayCurrencies             String?
  bankName                      String?
  bankAccountNumber             String?
  bankAccountName               String?
  bankBranch                    String?
  idleMessage                   String?               @default("Welcome!")
  idleLogoUrl                   String?
  tablePrefix                   String?               @default("T")
  receiptHeader                 String?
  receiptFooter                 String?
  parentBusinessId              String?
  franchiseFee                  Float?                @default(0)
  royaltyRate                   Float?                @default(0)
  cancelledAt                   DateTime?
  cancelReason                  String?
  serviceChargeDefault          Boolean               @default(false)
  enableCashDrawer              Boolean               @default(false)
  enableBarcodeScanner          Boolean               @default(true)
  enablePoleDisplay             Boolean               @default(false)
  totRate                       Float                 @default(3.0)
  receiptFormatSale             String                @default("THERMAL")
  receiptFormatInvoice          String                @default("A4")
  receiptFormatDelivery         String                @default("A4")
  receiptFormatEmail            String                @default("A4")
  apiKeys                       ApiKey[]
  appointments                  Appointment[]
  auditLogs                     AuditLog[]
  categories                    Category[]
  parentBusiness                Business?             @relation("FranchiseHierarchy", fields: [parentBusinessId], references: [id])
  franchisees                   Business[]            @relation("FranchiseHierarchy")
  deliveries                    DeliveryOrder[]
  mpesaC2BTransactions          MpesaC2BTransaction[]
  prescriptions                 Prescription[]
  referrals                     Referral[]            @relation("ReferrerBusiness")
  reportSchedules               ReportSchedule[]
  stores                        Store[]
  users                         User[]
  webhooks                      Webhook[]

  @@index([subscriptionStatus])
  @@index([referralCode])
}

model FranchiseReport {
  id                     String   @id @default(cuid())
  franchiseeBusinessId   String
  franchiseeBusinessName String
  parentBusinessId       String
  month                  Int
  year                   Int
  gmvCents               Int      @default(0)
  feeCents               Int      @default(0)
  royaltyCents           Int      @default(0)
  salesCount             Int      @default(0)
  createdAt              DateTime @default(now())

  @@unique([franchiseeBusinessId, month, year])
}

model User {
  id                 String        @id @default(uuid())
  businessId         String
  email              String?       @unique
  name               String
  role               String
  passwordHash       String?
  pin                String?
  // Driver pay. Earnings are what the driver is owed, which is not the delivery
  // fee charged to the customer — that is revenue. A flat rate per completed
  // delivery, and/or a percentage of the fee for value-based routes.
  deliveryRateCents         Int?
  deliveryCommissionPercent Int?
  pinHash            String?
  totpSecret         String?
  googleId           String?       @unique
  avatarUrl          String?
  deviceToken        String?
  phone              String?
  passwordChangedAt  DateTime?
  passwordExpiresAt  DateTime?
  mustChangePassword Boolean       @default(false)
  loginAttempts      Int           @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  employee              Employee?
  assignedKOTs          KOT[]                  @relation("ChefKOTs")
  orders                Order[]
  sales                 Sale[]
  business              Business               @relation(fields: [businessId], references: [id])
  sessions              UserSession[]
  assignedStores        UserStore[]
  timeEntries           TimeEntry[]
  webAuthnCredentials   WebAuthnCredential[]
  agentCustomers        Customer[]             @relation("AgentCustomers")
  agentVisits           AgentVisit[]
  agentFieldOrders      FieldOrder[]           @relation("AgentOrders")
  driverRuns            DeliveryRun[]          @relation("DriverRuns")
  creditRequestsBy      CreditApprovalRequest[] @relation("CreditRequestedBy")
  creditRequestsReviewed CreditApprovalRequest[] @relation("CreditReviewedBy")

  @@index([businessId, role])
}

model WebAuthnCredential {
  id           String   @id @default(uuid())
  userId       String
  credentialId String   @unique
  publicKeyDer String   // base64url DER-encoded SubjectPublicKeyInfo
  counter      Int      @default(0)
  transports   String?  // JSON array e.g. ["internal"]
  deviceName   String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Store {
  id               String          @id @default(uuid())
  businessId       String
  name             String
  storeCode        String          @unique
  receiptSequence  Int             @default(0)
  proformaSequence Int             @default(0)
  zReportSequence  Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  appointments     Appointment[]
  deliveries       DeliveryOrder[]
  items            Item[]
  orders           Order[]
  prescriptions    Prescription[]
  printers         Printer[]
  sales            Sale[]
  business         Business        @relation(fields: [businessId], references: [id])
  tables           Table[]
  assignedUsers    UserStore[]

  @@index([businessId])
}

model Item {
  id                  String               @id @default(uuid())
  offlineId           String?              @unique
  businessId          String
  storeId             String
  name                String
  type                String               @default("PRODUCT")
  retailPriceCents    Int
  wholesalePriceCents Int?
  vipPriceCents       Int?
  costPriceCents      Int?
  trackStock          Boolean              @default(true)
  trackSerials        Boolean              @default(false)
  trackBatches        Boolean              @default(false)
  trackExpiry         Boolean              @default(false)
  defaultExpiryDays   Int?
  negativeStockPolicy String?
  weightUnit          String?
  reorderLevel        Int?                 @default(0)
  vatApplicable       Boolean              @default(true)
  totApplicable       Boolean              @default(false)
  /// KRA tax class: A exempt, B standard 16%, C zero-rated, D not subject to VAT. vatApplicable is the older yes/no form of this.
  taxClass            String               @default("B")
  barcode             String?
  category            String?
  ageRestricted       Boolean              @default(false)
  minAgeYears         Int                  @default(18)
  prepTimeMinutes     Int                  @default(5)
  station             String?
  unitWeightGrams     Int?
  isActive            Boolean              @default(true)
  imageUrl            String?
  allergens           String               @default("[]")
  reorderQty          Int                  @default(1)
  tareWeightGrams     Int?
  binLocation         String?
  isWeighed           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  kraItemCode         String?
  soldOut             Boolean   @default(false)
  isFractional        Boolean   @default(false)
  unitLabel           String?
  availableFrom        String?
  availableTo          String?
  availableDays        String    @default("[0,1,2,3,4,5,6]")
  requiresPrescription Boolean   @default(false)
  genericName          String?
  drugClass            String?
  scheduleClass        String?
  dosageForm           String?
  strength             String?
  interactionWarnings  String    @default("[]")
  categoryId          String?
  batches              Batch[]
  bundleComponents    BundleComponent[]    @relation("BundleItem")
  componentOf         BundleComponent[]    @relation("ComponentItem")
  damagedGoodsRecords DamagedGoodsRecord[]
  movements           InventoryMovement[]
  store               Store                @relation(fields: [storeId], references: [id])
  itemCategory        Category?            @relation("CategoryItems", fields: [categoryId], references: [id], onDelete: SetNull)
  variants            ItemVariant[]
  uoms                ItemUOM[]
  orderItems          OrderItem[]
  ingredientOf        RecipeIngredient[]   @relation("IngredientItem")
  recipeIngredients   RecipeIngredient[]   @relation("RecipeItem")
  saleItems           SaleItem[]
  serialRecords       SerialRecord[]
  supplierReturnItems SupplierReturnItem[]
  fuelGrades          FuelGrade[]

  @@index([businessId, storeId])
  @@index([type])
  @@index([barcode])
  @@index([offlineId])
  @@index([categoryId])
}

model ItemVariant {
  id                  String   @id @default(uuid())
  itemId              String
  name                String
  sku                 String?  @unique
  barcode             String?  @unique
  retailPriceCents    Int
  wholesalePriceCents Int?
  vipPriceCents       Int?
  costPriceCents      Int?
  attributes          String
  trackStock          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  item                Item     @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([barcode])
  @@index([sku])
}

model Batch {
  id                String              @id @default(uuid())
  offlineId         String              @unique
  itemId            String
  storeId           String
  lotNumber         String
  manufacturingDate DateTime?
  expiryDate        DateTime?
  supplierId        String?
  quantityReceived  Float
  quantityRemaining Float
  status            String              @default("ACTIVE")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  item              Item                @relation(fields: [itemId], references: [id])
  movements         InventoryMovement[]

  @@index([itemId, expiryDate])
  @@index([status])
}

model Sale {
  id                 String              @id @default(uuid())
  offlineId          String              @unique
  businessId         String
  storeId            String?
  receiptNumber      String?             @unique
  amendmentNumber    String?
  orderId            String?             @unique
  cashierId          String?
  customerId         String?
  customerName       String?
  customerPhone      String?
  /// Buyer KRA PIN for a buyer who is not a Customer record (a fleet company). The Customer's own PIN wins.
  buyerKraPin        String?
  notes              String?
  proformaValidUntil DateTime?
  type               String              @default("NORMAL")
  status             String              @default("DRAFT")
  priceLevel         String              @default("RETAIL")
  subtotalCents      Int                 @default(0)
  serviceChargeCents Int                 @default(0)
  discountCents      Int                 @default(0)
  tipCents           Int                 @default(0)
  promotionId        String?
  vatCents           Int                 @default(0)
  totCents           Int                 @default(0)
  /// True when vatCents was computed line by line from tax classes; false for sales made before that.
  taxClassified      Boolean             @default(false)
  totalCents         Int                 @default(0)
  etimsSubmitted     Boolean             @default(false)
  etimsControlNumber String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  deliveries         DeliveryOrder[]
  movements          InventoryMovement[]
  layaway            Layaway?
  payments           Payment[]
  returns            Return[]
  cashier            User?               @relation(fields: [cashierId], references: [id])
  customer           Customer?           @relation(fields: [customerId], references: [id])
  order              Order?              @relation(fields: [orderId], references: [id])
  store              Store?              @relation(fields: [storeId], references: [id])
  items              SaleItem[]
  serialRecords      SerialRecord[]
  voidRecords        VoidRecord[]

  @@index([businessId, storeId, status])
  @@index([receiptNumber])
  @@index([offlineId])
}

model Order {
  id         String      @id @default(uuid())
  offlineId  String      @unique
  businessId String
  storeId    String
  tableId    String?
  roomNumber String?
  waiterId   String
  status     String      @default("OPEN")
  mode       String      @default("HOSPITALITY")
  priority   Int         @default(0)
  isVIP      Boolean     @default(false)
  coverCount Int         @default(1)
  tableNotes String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  kots       KOT[]
  store      Store       @relation(fields: [storeId], references: [id])
  table      Table?      @relation(fields: [tableId], references: [id])
  waiter     User        @relation(fields: [waiterId], references: [id])
  items      OrderItem[]
  sale       Sale?

  @@index([businessId, storeId, status])
  @@index([offlineId])
}

model Employee {
  id                         String                   @id @default(uuid())
  userId                     String                   @unique
  businessId                 String
  idNumber                   String?
  emergencyContact           String?
  employmentType             String                   @default("PERMANENT")
  commissionRate             Float                    @default(0)
  commissionBasis            String                   @default("SALES_VALUE")
  salesTargetCents           Int?
  commissionMilestonePercent Float?                   @default(0)
  salaryBaseCents            Int                      @default(0)
  housingAllowanceCents      Int                      @default(0)
  transportAllowanceCents    Int                      @default(0)
  otherAllowancesCents       Int                      @default(0)
  saccoDeductionCents        Int                      @default(0)
  loanDeductionCents         Int                      @default(0)
  otherDeductionsCents       Int                      @default(0)
  bankAccountNumber          String?
  bankName                   String?
  startDate                  DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  contractEndDate            DateTime?
  contractType               String?                  @default("PERMANENT")
  attendance                 AttendanceRecord[]
  disciplinaryRecords        DisciplinaryRecord[]
  user                       User                     @relation(fields: [userId], references: [id])
  expenseClaims              ExpenseClaim[]
  housekeepingAssignments    HousekeepingAssignment[]
  leaves                     Leave[]
  leaveBalances              LeaveBalance[]
  salaryAdvances             SalaryAdvance[]

  @@index([businessId])
}

model SalaryAdvance {
  id             String    @id @default(uuid())
  businessId     String
  employeeId     String
  amountCents    Int
  reason         String
  status         String    @default("PENDING")  // PENDING | APPROVED | REJECTED | DEDUCTED
  approvedBy     String?
  rejectedBy     String?
  rejectionNote  String?
  deductedAt     DateTime?
  payrollRunId   String?
  requestedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  employee       Employee  @relation(fields: [employeeId], references: [id])

  @@index([businessId])
  @@index([employeeId])
}

model ExpenseClaim {
  id              String   @id @default(uuid())
  businessId      String
  employeeId      String
  amountCents     Int
  description     String
  category        String   @default("OTHER")
  receiptUrl      String?
  status          String   @default("PENDING")
  approvedBy      String?
  rejectedBy      String?
  rejectionReason String?
  submittedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  employee        Employee @relation(fields: [employeeId], references: [id])

  @@index([businessId])
  @@index([employeeId])
}

model AuditLog {
  id           String   @id @default(uuid())
  businessId   String
  previousHash String
  hash         String
  actor        String
  actorType    String
  action       String
  entity       String
  entityId     String
  before       String?
  after        String?
  source       String
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id])

  @@index([businessId, createdAt])
  @@index([entity, entityId])
}

model ApiKey {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  keyHash     String    @unique
  scopes      String
  ipWhitelist String
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business  @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model SaleItem {
  id             String   @id @default(uuid())
  saleId         String
  itemId         String?
  name           String
  quantity       Float
  unitPriceCents Int
  totalCents     Int
  /// The tax class the line was sold under (null on sales made before classes existed).
  taxClass       String?
  /// VAT extracted from this line, after its share of the sale discount.
  vatCents       Int      @default(0)
  /// This line's share of the sale-level discount.
  discountCents  Int      @default(0)
  createdAt      DateTime @default(now())
  item           Item?    @relation(fields: [itemId], references: [id])
  sale           Sale     @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model OrderItem {
  id                  String    @id @default(uuid())
  orderId             String
  itemId              String
  name                String
  quantity            Int
  unitPriceCents      Int
  totalCents          Int
  specialInstructions String?
  modifiers           String?
  course              String?
  firedAt             DateTime?
  sentToKitchenAt     DateTime?
  seatNumber          Int?      @default(0)
  createdAt           DateTime  @default(now())
  item                Item      @relation(fields: [itemId], references: [id])
  order               Order     @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model MpesaC2BTransaction {
  id                String    @id @default(cuid())
  businessId        String
  transactionId     String    @unique
  transactionType   String
  phoneNumber       String
  customerName      String
  amountCents       Int
  billRefNumber     String    @default("")
  orgAccountBalance Int?
  shortCode         String?
  status            String    @default("PENDING")
  saleId            String?
  matchedBy         String?
  matchedAt         DateTime?
  rawPayload        Json?
  createdAt         DateTime  @default(now())
  business          Business  @relation(fields: [businessId], references: [id])

  @@index([businessId, status])
  @@index([createdAt])
}

model Payment {
  id          String   @id @default(uuid())
  offlineId   String   @unique
  saleId      String
  method      String
  amountCents Int
  reference   String?
  createdAt   DateTime @default(now())
  sale        Sale     @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model VoidRecord {
  id                String   @id @default(uuid())
  saleId            String
  type              String
  authorizedBy      String
  reason            String
  voidedItemIds     String
  refundAmountCents Int
  etimsVoidRef      String?
  createdAt         DateTime @default(now())
  sale              Sale     @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model InventoryMovement {
  id           String   @id @default(uuid())
  offlineId    String   @unique
  businessId   String
  itemId       String
  storeId      String
  type         String
  quantity     Float
  batchId      String?
  saleId       String?
  recipeItemId String?
  bundleItemId String?
  grnId        String?
  variantId    String?
  source       String
  createdAt    DateTime @default(now())
  batch        Batch?   @relation(fields: [batchId], references: [id])
  item         Item     @relation(fields: [itemId], references: [id])
  sale         Sale?    @relation(fields: [saleId], references: [id])

  @@index([businessId, itemId, createdAt])
  @@index([type])
  @@index([offlineId])
}

model Table {
  id           String             @id @default(uuid())
  storeId      String
  number       String
  capacity     Int
  floor        String?
  status       String             @default("AVAILABLE")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  orders       Order[]
  store        Store              @relation(fields: [storeId], references: [id])
  reservations TableReservation[]

  @@index([storeId, status])
}

model Printer {
  id                String   @id @default(uuid())
  storeId           String
  name              String
  connectionType    String
  connectionDetails String
  isDefault         Boolean  @default(false)
  handles           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  store             Store    @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model BundleComponent {
  id              String   @id @default(uuid())
  bundleItemId    String
  componentItemId String
  quantity        Int
  createdAt       DateTime @default(now())
  bundleItem      Item     @relation("BundleItem", fields: [bundleItemId], references: [id])
  componentItem   Item     @relation("ComponentItem", fields: [componentItemId], references: [id])

  @@index([bundleItemId])
}

model RecipeIngredient {
  id               String   @id @default(uuid())
  recipeItemId     String
  ingredientItemId String
  quantityGrams    Float
  createdAt        DateTime @default(now())
  ingredientItem   Item     @relation("IngredientItem", fields: [ingredientItemId], references: [id])
  recipeItem       Item     @relation("RecipeItem", fields: [recipeItemId], references: [id])

  @@index([recipeItemId])
}

model Supplier {
  id                      String                   @id @default(uuid())
  businessId              String
  name                    String
  contact                 String?                  // legacy free-text "phone / email" — prefer phone/email below
  phone                   String?                  // E.164-ish, used for WhatsApp
  email                   String?
  address                 String?
  paymentTerms            String?
  creditLimitCents        Int?
  outstandingBalanceCents Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  purchaseOrders          PurchaseOrder[]
  rfqResponses            RFQResponse[]
  creditNotes             SupplierCreditNote[]
  invoices                SupplierInvoice[]
  priceAgreements         SupplierPriceAgreement[]
  returns                 SupplierReturn[]
  catalogueItems          SupplierCatalogueItem[]

  @@index([businessId])
}

model PurchaseOrder {
  id               String    @id @default(uuid())
  poNumber         String    @unique
  businessId       String
  supplierId       String
  status           String    @default("DRAFT")
  expectedDelivery DateTime?
  notes            String?
  invoiceNumber    String?
  invoicedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  grns             GRN[]
  items            POItem[]
  supplier         Supplier  @relation(fields: [supplierId], references: [id])

  @@index([businessId, supplierId, status])
}

model POItem {
  id               String        @id @default(uuid())
  poId             String
  itemId           String
  quantityOrdered  Float
  agreedPriceCents Int
  createdAt        DateTime      @default(now())
  po               PurchaseOrder @relation(fields: [poId], references: [id])

  @@index([poId])
}

model GRN {
  id                  String        @id @default(uuid())
  poId                String
  receivedAt          DateTime      @default(now())
  freightCents        Int           @default(0)
  dutyPaidCents       Int           @default(0)
  landedCostAllocated Boolean       @default(false)
  createdAt           DateTime      @default(now())
  po                  PurchaseOrder @relation(fields: [poId], references: [id])
  items               GRNItem[]

  @@index([poId])
}

model GRNItem {
  id               String    @id @default(uuid())
  grnId            String
  poItemId         String
  quantityReceived Float
  batchLotNumber   String?
  expiryDate       DateTime?
  landedCostCents  Int       @default(0)
  createdAt        DateTime  @default(now())
  grn              GRN       @relation(fields: [grnId], references: [id])

