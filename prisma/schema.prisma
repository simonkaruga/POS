// ── Affiliate program (external partners, separate from business referrals) ──
model Affiliate {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  phone             String?
  passwordHash      String
  code              String    @unique // unique promo code/link slug, e.g. AFF-XXXXXX
  status            String    @default("PENDING") // PENDING | ACTIVE | SUSPENDED | REJECTED
  commissionPercent Int       @default(10)        // recurring % of each subscription payment
  payoutMethod      String?                       // MPESA | BANK
  payoutDetails     String?                       // M-Pesa phone or bank account
  balanceCents      Int       @default(0)         // earned but not yet paid out
  totalEarnedCents  Int       @default(0)
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  conversions       AffiliateConversion[]
  commissions       AffiliateCommission[]
  payouts           AffiliatePayout[]

  @@index([code])
  @@index([status])
}

// A business attributed to an affiliate (one business → at most one affiliate).
model AffiliateConversion {
  id           String    @id @default(uuid())
  affiliateId  String
  businessId   String    @unique
  status       String    @default("SIGNED_UP") // SIGNED_UP | SUBSCRIBED | CHURNED
  subscribedAt DateTime?
  createdAt    DateTime  @default(now())
  affiliate    Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
}

// One commission earned from a single subscription payment (recurring model).
model AffiliateCommission {
  id          String    @id @default(uuid())
  affiliateId String
  businessId  String
  amountCents Int
  baseCents   Int       // the payment the commission was computed from
  percent     Int
  status      String    @default("PENDING") // PENDING | PAID
  payoutId    String?
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([businessId])
}

model AffiliatePayout {
  id          String    @id @default(uuid())
  affiliateId String
  amountCents Int
  method      String?   // MPESA | BANK
  reference   String?   // M-Pesa code / bank reference
  notes       String?
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
}

model LicenseKey {
  id          String    @id @default(uuid())
  key         String    @unique
  businessId  String?
  tier        String    @default("STARTER")
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  activatedAt DateTime?
  // The one server computer this key runs on, set when the offline edition first activates it. Cleared by "release".
  machineId   String?
  hostname    String?
  boundAt     DateTime?
  // The last time that computer renewed its licence (it does so quietly whenever it is online).
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId])
  @@index([key])
  @@index([machineId])
}

// The licence an offline (LOCAL) installation holds: one row, id "local". The token is signed by the Faida server and
// checked here with the public key, so it cannot be forged; the rest is a readable copy for the status screen.
model LocalLicense {
  id               String    @id @default("local")
  key              String
  token            String
  tier             String
  machineId        String
  licenseExpiresAt DateTime?
  tokenExpiresAt   DateTime
  activatedAt      DateTime  @default(now())
  lastRenewedAt    DateTime  @default(now())
  // The latest time this computer has seen. The clock can never be wound back past it to stretch a licence.
  lastSeenAt       DateTime  @default(now())
  // What the licence server last said when asked to renew: OK, REVOKED, EXPIRED, OTHER_COMPUTER, or UNREACHABLE.
  serverStatus     String    @default("OK")
  serverMessage    String?
  updatedAt        DateTime  @updatedAt
}

model SuperAdmin {
  id           String   @id @default(uuid())
