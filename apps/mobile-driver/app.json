{
  "expo": {
    "name": "Faida Driver",
    "slug": "faida-driver",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "faida-driver",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F3F6FC"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#01275C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.ke.faida.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Location is used to show your position on the delivery map.",
        "NSLocationAlwaysUsageDescription": "Location is used for delivery tracking while the app is in the background.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#01275C"
      },
      "package": "co.ke.faida.driver",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CALL_PHONE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CALL_PHONE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Faida Driver to use your location for delivery tracking."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#030712"
        }
      ],
      "./plugins/with-cleartext-traffic",
      "./plugins/with-gradle-properties"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
