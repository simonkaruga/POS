{
  "expo": {
    "name": "Faida POS",
    "slug": "faida-pos-cashier",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "faida-pos",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F3F6FC"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#01275C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.ke.faida.pos",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used to scan product barcodes at point of sale.",
        "NSPhotoLibraryUsageDescription": "Used to attach receipt photos to expense records.",
        "NSLocalNetworkUsageDescription": "Used to send receipts to a Wi-Fi receipt printer on your network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#01275C"
      },
      "package": "co.ke.faida.pos",
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Faida POS to use Face ID to sign you in."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Faida POS to access your camera for barcode scanning."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#030712"
        }
      ],
      "./plugins/with-cleartext-traffic",
      "./plugins/with-printer-permissions",
      "./plugins/with-gradle-properties"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
