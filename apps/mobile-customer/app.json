{
  "expo": {
    "name": "Faida Order",
    "slug": "faida-customer",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "faida-order",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F3F6FC"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#01275C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.ke.faida.order",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#01275C"
      },
      "package": "co.ke.faida.order"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#030712"
        }
      ],
      "./plugins/with-cleartext-traffic",
      "./plugins/with-gradle-properties"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
